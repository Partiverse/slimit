{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlimIt",
  "version": "0.1.0",
  "identifier": "dev.partiverse.slimit",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "ui"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "ui"
    },
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SlimIt",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
